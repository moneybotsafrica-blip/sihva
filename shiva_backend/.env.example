# Database
DATABASE_URL=sqlite+aiosqlite:///./shiva_support.db

# Qdrant Local Configuration
# For local development, Qdrant runs on localhost:6333
# To set up local Qdrant, run: .\setup_qdrant_local.ps1
# Then start Qdrant: C:\qdrant\start_qdrant.bat
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Leave empty for local instance

# Qdrant Settings
QDRANT_COLLECTION_NAME=knowledge_base
QDRANT_SIMILARITY_THRESHOLD=0.75

# Groq Configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Gemini Configuration (for complex tasks)
# Get your API key from https://aistudio.google.com/app/apikey
# When configured, Gemini is used for complex issues (complexity >= 0.7)
# If not set, Groq handles all tasks
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_COMPLEXITY_THRESHOLD=0.7

# Auth
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting
RATE_LIMIT_PER_CUSTOMER=100
RATE_LIMIT_PER_IP=50
RATE_LIMIT_WINDOW_SECONDS=60

# AI Routing
SUPPORT_AI_CONFIDENCE_THRESHOLD=0.3
CODE_AI_ENABLED=true
MAX_AI_ATTEMPTS_BEFORE_ESCALATION=5
DEFAULT_ESCALATION_STAFF_ID=staff_001

# Logging
LOG_LEVEL=INFO
