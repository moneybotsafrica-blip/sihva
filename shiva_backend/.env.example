# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./shiva_support.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname

# Database Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Customer API Configuration
CUSTOMER_API_KEY=your_customer_api_key
CUSTOMER_API_BASE_URL=https://api.example.com

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_base
QDRANT_SIMILARITY_THRESHOLD=0.75

# Groq AI Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Codex AI Configuration
CODEX_API_KEY=your_codex_api_key
CODEX_MODEL=gpt-4-codex

# Authentication Configuration
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Rate Limiting Configuration
RATE_LIMIT_PER_CUSTOMER=100
RATE_LIMIT_PER_IP=50
RATE_LIMIT_WINDOW_SECONDS=60

# AI Routing Configuration
SUPPORT_AI_CONFIDENCE_THRESHOLD=0.50
CODE_AI_ENABLED=true

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Logging Configuration
LOG_LEVEL=INFO